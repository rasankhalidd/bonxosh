# Copy to .env (git-ignored) and fill in.
# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The SERVICE ROLE key (secret!) — only this script uses it. Never put it in config.js.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: rotating residential proxy if Parfumo starts blocking you
# DECODO_PROXY_URL=http://user:pass@gate.decodo.com:7000

# Optional: use an installed Chrome instead of Puppeteer's bundled one
# BROWSER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
